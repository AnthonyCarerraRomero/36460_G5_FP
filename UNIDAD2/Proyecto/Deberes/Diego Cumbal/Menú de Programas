#include <stdio.h>

int main() {
    int opcion;
    int n, i, j;

    do {
        printf("\n=== MENU PRINCIPAL ===\n");
        printf("1. Cuadrado hueco\n");
        printf("2. Serie de Fibonacci\n");
        printf("3. Salir\n");
        printf("Elija una opcion: ");
        scanf("%d", &opcion);

        switch (opcion) {
            case 1:
                // Validar tamano del cuadrado
                do {
                    printf("\nIngrese el tamano del lado del cuadrado (mayor a 0): ");
                    scanf("%d", &n);
                    if (n <= 0) {
                        printf("Error: No se permiten valores negativos ni cero.\n");
                    }
                } while (n <= 0);

                printf("\n");
                // Dibujar cuadrado hueco
                for (i = 1; i <= n; i++) {
                    for (j = 1; j <= n; j++) {
                        if (i == 1 || i == n || j == 1 || j == n) {
                            printf("* ");
                        } else {
                            printf("  ");
                        }
                    }
                    printf("\n");
                }
                break;

            case 2:
                // Validar cantidad de terminos
                do {
                    printf("\nIngrese cuantos terminos de Fibonacci desea ver (mayor a 0): ");
                    scanf("%d", &n);
                    if (n <= 0) {
                        printf("Error: No se permiten valores negativos ni cero.\n");
                    }
                } while (n <= 0);

                {
                    int a = 0, b = 1, siguiente;

                    printf("\nSerie de Fibonacci:\n");
                    for (i = 1; i <= n; i++) {
                        printf("%d  ", a);
                        siguiente = a + b;
                        a = b;
                        b = siguiente;
                    }
                    printf("\n");
                }
                break;

            case 3:
                printf("\nSaliendo del programa...\n");
                break;

            default:
                printf("\nOpcion incorrecta, intente de nuevo.\n");
                break;
        }

    } while (opcion != 3);

    return 0;
}
