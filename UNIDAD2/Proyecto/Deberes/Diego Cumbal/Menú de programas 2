#include <stdio.h>

int main() {
    int opcion;
    int n, i, j;

    do {
        printf("\n=== MENU PRINCIPAL ===\n");
        printf("1. Vector de N terminos\n");
        printf("2. Matriz de N x N\n");
        printf("3. Salir\n");
        printf("Elija una opcion: ");
        scanf("%d", &opcion);

        switch (opcion) {
            case 1:
                // Validar tamano del vector
                do {
                    printf("\nIngrese el tamano del vector (mayor a 0): ");
                    scanf("%d", &n);
                    if (n <= 0) {
                        printf("Error: No se permiten valores negativos ni cero.\n");
                    }
                } while (n <= 0);

                {
                    int vector[n];

                    // Llenar vector evitando negativos
                    for (i = 0; i < n; i++) {
                        do {
                            printf("Ingrese el valor para la posicion [%d]: ", i + 1);
                            scanf("%d", &vector[i]);
                            if (vector[i] < 0) {
                                printf("Error: No se permiten valores negativos. Intente de nuevo.\n");
                            }
                        } while (vector[i] < 0);
                    }

                    // Mostrar vector
                    printf("\nVector ingresado:\n");
                    for (i = 0; i < n; i++) {
                        printf("%d  ", vector[i]);
                    }
                    printf("\n");
                }
                break;

            case 2:
                // Validar dimension de la matriz
                do {
                    printf("\nIngrese el tamano N para la matriz N x N (mayor a 0): ");
                    scanf("%d", &n);
                    if (n <= 0) {
                        printf("Error: No se permiten valores negativos ni cero.\n");
                    }
                } while (n <= 0);

                {
                    int matriz[n][n];

                    // Llenar matriz evitando negativos
                    for (i = 0; i < n; i++) {
                        for (j = 0; j < n; j++) {
                            do {
                                printf("Ingrese el valor para [%d][%d]: ", i + 1, j + 1);
                                scanf("%d", &matriz[i][j]);
                                if (matriz[i][j] < 0) {
                                    printf("Error: No se permiten valores negativos. Intente de nuevo.\n");
                                }
                            } while (matriz[i][j] < 0);
                        }
                    }

                    // Mostrar matriz
                    printf("\nMatriz ingresada:\n");
                    for (i = 0; i < n; i++) {
                        for (j = 0; j < n; j++) {
                            printf("%d\t", matriz[i][j]);
                        }
                        printf("\n");
                    }
                }
                break;

            case 3:
                printf("\nSaliendo del programa...\n");
                break;

            default:
                printf("\nOpcion incorrecta, intente de nuevo.\n");
                break;
        }

    } while (opcion != 3);

    return 0;
}
