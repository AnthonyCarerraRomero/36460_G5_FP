#include <stdio.h>

int main(void) {
    // Variables enteras para dividendo (x) y divisor (y)
    int x, y;

    // Lectura de los dos numeros enteros
    printf("Ingrese el valor de x: ");
    if (scanf("%d", &x) != 1) {
        printf("Error: entrada no valida.\n");
        return 1;
    }

    printf("Ingrese el valor de y: ");
    if (scanf("%d", &y) != 1) {
        printf("Error: entrada no valida.\n");
        return 1;
    }

    // Evaluacion de condiciones: control de division por cero y calculo del modulo
    if (y == 0) {
        printf("Error: no se puede dividir para cero.\n");
    } else if (x % y == 0) {
        printf("%d es divisible para %d.\n", x, y);
    } else {
        printf("%d no es divisible para %d.\n", x, y);
    }

    return 0;
}
