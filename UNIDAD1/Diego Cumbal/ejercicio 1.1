#include <stdio.h>

int main(void) {
    // Declaracion de variables para almacenar los dos numeros y el promedio
    float num1, num2, media;

    // Entrada y validacion del primer numero
    printf("Ingrese el primer numero: ");
    if (scanf("%f", &num1) != 1) {
        printf("Error: entrada no valida.\n");
        return 1;
    }

    // Entrada y validacion del segundo numero
    printf("Ingrese el segundo numero: ");
    if (scanf("%f", &num2) != 1) {
        printf("Error: entrada no valida.\n");
        return 1;
    }

    // Calculo de la media aritmetica de los dos valores
    media = (num1 + num2) / 2.0f;

    // Salida por pantalla del resultado obtenido
    printf("La media de %.2f y %.2f es: %.2f\n", num1, num2, media);

    return 0;
}
