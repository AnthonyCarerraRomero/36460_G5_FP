#include <stdio.h>
#include <stdbool.h>

int main(void) {
    int anio;

    // Lectura del anio a comprobar
    printf("Ingresa un anio: ");
    if (scanf("%d", &anio) != 1 || anio <= 0) {
        printf("Error: anio no valido.\n");
        return 1;
    }

    // Regla del calendario gregoriano: divisible para 4 y no por 100, o directamente divisible para 400
    bool es_bisiesto = ((anio % 4 == 0 && anio % 100 != 0) || (anio % 400 == 0));

    // Despliegue de la evaluacion
    if (es_bisiesto) {
        printf("%d es bisiesto.\n", anio);
    } else {
        printf("%d no es bisiesto.\n", anio);
    }

    return 0;
}
